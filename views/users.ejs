<!-- y a un probleme avec les pdp des users mais on va le regler apres -->


<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Ma Bibliothèque</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #f4f4f9; padding: 20px; }
        .books-grid { display: flex; flex-wrap: wrap; gap: 20px; justify-content: center; }
        .book-card { 
            background: white; border-radius: 8px; padding: 15px; 
            width: 250px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); 
            text-align: center;
        }
        .book-cover { 
            width: 100%; height: 350px; object-fit: cover; 
            border-radius: 4px; margin-bottom: 10px;
        }
        .genre-badge {
            background: #3498db; color: white; padding: 5px 10px; 
            border-radius: 15px; font-size: 0.8em; display: inline-block;
        }
    </style>
</head>
<body>

    <h1 style="text-align: center;">Ma Bibliothèque Alinéa</h1>

    <div class="books-grid">
        <% if (users.length === 0) { %>
            <p>Aucun livre n'a encore été ajouté !</p>
        <% } else { %>
            <% users.forEach(function(user) { %>
                <div class="book-card">
                    
                    <% if (user.pdp) { %>
                        <img src="<%= user.pdp %>" alt="Photo de profil" class="book-cover">
                    <% } else { %>
                        <div class="book-cover" style="background: #ccc; display: flex; align-items: center; justify-content: center;">Pas d'image</div>
                    <% } %>

                    <h3><%= user.name %></h3>
                    <p style="color: #666;"><%= user.email %></p>

                </div>
            <% }); %>
        <% } %>
    </div>

</body>
</html>